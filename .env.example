# Copy to .env.local and adjust. Every variable the application reads is listed
# here; it is validated by src/lib/config/env.ts at build time.

# Which content repository backs dynamic surfaces: mock | api
CONTENT_SOURCE=mock

# Spring Boot gateway. Required when CONTENT_SOURCE=api. Never NEXT_PUBLIC_ —
# the browser must not see it.
API_BASE_URL=

# Timeout applied to backend calls, in milliseconds.
API_TIMEOUT_MS=8000

# Azure Blob container serving investor PDFs, news imagery and team portraits.
# Account plus container, with no trailing slash — everything below it is a path
# stored in the data, so no hostname is committed (/CLAUDE.md §7).
# The team portraits supplied on 2026-09-10 sit at web-assets/media/our-team/.
#
# Leave it empty and blobUrl() cannot compose: /our-team/ then falls back to an
# initials avatar per person rather than failing, so the roster still renders.
AZURE_BLOB_BASE_URL=https://softboardlitecdn.blob.core.windows.net/sael-website

# TEMPORARY — the legacy site's origin, while the Offer Documents files are not
# yet in the blob container. When set, those documents and the two DRHP videos
# link to the legacy site's own copies (each fixture row records its legacy
# path) instead of their container paths, which 404 until the upload. The
# client's instruction of 2026-09-29.
#
# The Newsroom's images (cards, article leads and body images) follow the same
# rule since 2026-10-01. next.config.ts also reads this variable, at build
# time, to let next/image optimise images from this origin's /img/ — so set it
# for `pnpm build` too, not only at runtime.
#
# Remove it once the files are uploaded — and before cutover at the latest,
# when this origin starts serving the new site and those paths stop existing.
LEGACY_ASSET_BASE_URL=https://www.sael.co

# Canonical public origin. Drives metadataBase, sitemap and canonical URLs.
NEXT_PUBLIC_SITE_URL=https://www.sael.co

# Oracle recruiting system — the href of the two "Explore" buttons on /career/.
# Leave it empty and the page renders without them rather than linking nowhere.
CAREER_REDIRECT_URL=

# Artificial delay on mock repository reads, for testing loading states.
MOCK_LATENCY_MS=0

# Build-time only, and not needed for the client's deployment. Leave unset and
# `pnpm build` emits the standalone artefact PM2 runs (/CLAUDE.md §7). Set to
# `false` only on a host that builds its own server output — a Vercel preview
# fails with an ENOENT on `.next/next-server.js.nft.json` otherwise.
STANDALONE_OUTPUT=
